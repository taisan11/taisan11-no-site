---
import Layout from "../../layouts/layout.astro";
import A from "../../components/A.astro";
---

<Layout title="QrDrop | taisan11のサイト">
  <div class="nue">
    <A href="/tools">← 戻る</A><br />
    <div class="c">
      <h2>QrDrop</h2>
      <p>ファイルをQRコードで送受信します。</p>
      <p>両方とも画面とカメラが同じ面にあり、画角に収めれる場合にのみ使用できますが、とても高速です。</p>
    </div>

    <section class="facetoface-panel" aria-label="対面転送">
      <div class="transfer-controls">
        <label for="file-f2f-send">送信ファイル</label>
        <input type="file" name="file-f2f-send" id="file-f2f-send" />
        <button id="f2f-send-btn" type="button">送信開始</button>
        <button id="f2f-recv-btn" type="button">受信開始</button>
        <button id="f2f-stop-btn" type="button" disabled>停止</button>
      </div>
      <p>送信側はファイルを選んで「送信開始」、受信側は「受信開始」を押してください。</p>
      <p class="status" id="f2f-info" role="status">📷 送信または受信を開始してください。</p>
      <a id="f2f-download" hidden>受信ファイルを保存</a>

      <div class="facetoface-layout">
        <div class="facetoface-side">
          <h3 id="f2f-qr-label">QRコード</h3>
          <div id="f2f-qr-box" aria-live="polite"></div>
        </div>
        <div class="facetoface-side">
          <h3>カメラプレビュー</h3>
          <div class="camera-wrap">
            <video id="f2f-video" playsinline autoplay muted></video>
            <canvas id="f2f-overlay"></canvas>
          </div>
          <div class="camera-select-wrap" id="f2f-camera-select-wrap" hidden>
            <label>カメラ: <select id="f2f-camera-select"></select></label>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
import { encodeQR } from "qr";
import { QRCanvas, selfieCamera, frameLoop } from "qr/dom.js";

// QR byte mode: 13-byte header + up to 2000 raw payload bytes (ECC low).
const MAGIC = new Uint8Array([0x51, 0x44, 0x52, 0x32]); // QDR2
const HEADER_SIZE = 13;
const CHUNK_SIZE = 600;
const utf8Encoder = new TextEncoder();
const utf8Decoder = new TextDecoder("utf-8", { fatal: true });

// === Types ===
interface TransferFile {
  name: string;
  type: string;
  bytes: Uint8Array;
}

type Packet = { id: number; seq: number } & (
  | { t: "start"; name: string; type: string; size: number; originalSize: number; chunkSize: number; chunkCount: number }
  | { t: "data"; i: number; data: Uint8Array }
  | { t: "end" }
  | { t: "ack" }
);

interface SenderState {
  file: TransferFile;
  packets: Packet[];
  dataCount: number;
  index: number;
  completed: boolean;
}

interface ReceiverState {
  id: number;
  name: string;
  type: string;
  size: number;
  originalSize: number;
  chunkSize: number;
  chunkCount: number;
  chunks: (Uint8Array | null)[];
  received: number;
  receivedCount: number;
  finishing: boolean;
  completed: boolean;
}

// === Utilities ===
// qr's hooks bridge raw QR byte segments to its string-based public API.
// Do not use TextDecoder("latin1"): it remaps bytes 0x80..0x9f.
function binaryText(bytes: Uint8Array): string {
  return String.fromCharCode(...bytes);
}

async function compressBytes(bytes: Uint8Array): Promise<Uint8Array> {
  const stream = new ReadableStream({ start: (c) => { c.enqueue(bytes); c.close(); } });
  const compressed = stream.pipeThrough(new CompressionStream("gzip"));
  const reader = compressed.getReader();
  const chunks: Uint8Array[] = [];
  while (true) {
    const { done, value } = await reader.read();
    if (done) break;
    if (value) chunks.push(value);
  }
  const total = chunks.reduce((s, c) => s + c.length, 0);
  const result = new Uint8Array(total);
  let offset = 0;
  for (const chunk of chunks) {
    result.set(chunk, offset);
    offset += chunk.length;
  }
  return result;
}

async function decompressBytes(bytes: Uint8Array): Promise<Uint8Array> {
  const stream = new ReadableStream({ start: (c) => { c.enqueue(bytes); c.close(); } });
  const decompressed = stream.pipeThrough(new DecompressionStream("gzip"));
  const reader = decompressed.getReader();
  const chunks: Uint8Array[] = [];
  while (true) {
    const { done, value } = await reader.read();
    if (done) break;
    if (value) chunks.push(value);
  }
  const total = chunks.reduce((s, c) => s + c.length, 0);
  const result = new Uint8Array(total);
  let offset = 0;
  for (const chunk of chunks) {
    result.set(chunk, offset);
    offset += chunk.length;
  }
  return result;
}

function makePacket(packet: Packet): Uint8Array {
  const kinds = { start: 0, data: 1, end: 2, ack: 3 } as const;
  const name = packet.t === "start" ? utf8Encoder.encode(packet.name) : new Uint8Array();
  const type = packet.t === "start" ? utf8Encoder.encode(packet.type) : new Uint8Array();
  const payloadSize = packet.t === "start" ? 18 + name.length + type.length
    : packet.t === "data" ? packet.data.length : 0;
  if (name.length > 65535 || type.length > 65535 || HEADER_SIZE + payloadSize > 2953) {
    throw new Error("QRに収まらないメタデータです。ファイル名を短くしてください。");
  }
  const bytes = new Uint8Array(HEADER_SIZE + payloadSize);
  const view = new DataView(bytes.buffer);
  bytes.set(MAGIC);
  view.setUint8(4, kinds[packet.t]);
  view.setUint32(5, packet.id);
  view.setUint32(9, packet.seq);
  if (packet.t === "start") {
    view.setUint32(13, packet.size);
    view.setUint32(17, packet.originalSize);
    view.setUint16(21, packet.chunkSize);
    view.setUint32(23, packet.chunkCount);
    view.setUint16(27, name.length);
    view.setUint16(29, type.length);
    bytes.set(name, 31);
    bytes.set(type, 31 + name.length);
  } else if (packet.t === "data") {
    bytes.set(packet.data, HEADER_SIZE);
  }
  return bytes;
}

function parsePacket(text: string): Packet | null {
  if (text.length < HEADER_SIZE || text.length > 2953) return null;
  const bytes = Uint8Array.from(text, (char) => char.charCodeAt(0));
  if (!MAGIC.every((byte, i) => bytes[i] === byte)) return null;
  const view = new DataView(bytes.buffer);
  const kind = view.getUint8(4);
  const id = view.getUint32(5);
  const seq = view.getUint32(9);
  if (kind === 0) {
    if (seq !== 0 || bytes.length < 31) return null;
    const size = view.getUint32(13);
    const originalSize = view.getUint32(17);
    const chunkSize = view.getUint16(21);
    const chunkCount = view.getUint32(23);
    const nameLength = view.getUint16(27);
    const typeLength = view.getUint16(29);
    if (chunkSize !== CHUNK_SIZE || chunkCount !== Math.ceil(size / chunkSize)
      || bytes.length !== 31 + nameLength + typeLength) return null;
    try {
      return {
        t: "start", id, seq, size, originalSize, chunkSize, chunkCount,
        name: utf8Decoder.decode(bytes.subarray(31, 31 + nameLength)),
        type: utf8Decoder.decode(bytes.subarray(31 + nameLength)),
      };
    } catch { return null; }
  }
  if (kind === 1 && seq > 0 && bytes.length > HEADER_SIZE
    && bytes.length <= HEADER_SIZE + CHUNK_SIZE) {
    return { t: "data", id, seq, i: seq - 1, data: bytes.subarray(HEADER_SIZE) };
  }
  if (bytes.length !== HEADER_SIZE) return null;
  if (kind === 2 && seq > 0) return { t: "end", id, seq };
  if (kind === 3) return { t: "ack", id, seq };
  return null;
}

function renderQR(packet: Packet, target: HTMLDivElement): void {
  const bytes = makePacket(packet);
  target.innerHTML = encodeQR("", "svg", {
    ecc: "low", encoding: "byte", textEncoder: () => bytes,
  });
}

function getChunks(bytes: Uint8Array): Uint8Array[] {
  const chunks: Uint8Array[] = [];
  for (let i = 0; i < bytes.length; i += CHUNK_SIZE) chunks.push(bytes.subarray(i, i + CHUNK_SIZE));
  return chunks;
}

async function prepareSender(file: TransferFile): Promise<SenderState> {
  const compressed = await compressBytes(file.bytes);
  if (file.bytes.length > 0xffffffff || compressed.length > 0xffffffff) {
    throw new Error("ファイルが大きすぎます。");
  }
  const chunks = getChunks(compressed);
  const id = crypto.getRandomValues(new Uint32Array(1))[0];
  const packets: Packet[] = [
    {
      t: "start", id, seq: 0, name: file.name,
      type: file.type || "application/octet-stream",
      originalSize: file.bytes.length, size: compressed.length,
      chunkSize: CHUNK_SIZE, chunkCount: chunks.length,
    },
    ...chunks.map((data, i): Packet => ({ t: "data", id, seq: i + 1, i, data })),
    { t: "end", id, seq: chunks.length + 1 },
  ];
  makePacket(packets[0]); // Validate metadata before starting the transfer.
  return { file, packets, dataCount: chunks.length, index: 0, completed: false };
}

function createReceiver(packet: Extract<Packet, { t: "start" }>): ReceiverState {
  return {
    ...packet,
    chunks: Array.from({ length: packet.chunkCount }, () => null),
    received: 0, receivedCount: 0, finishing: false, completed: false,
  };
}

function acceptChunk(state: ReceiverState, packet: Extract<Packet, { t: "data" }>): boolean {
  if (packet.i >= state.chunkCount
    || packet.data.length !== Math.min(state.chunkSize, state.size - packet.i * state.chunkSize)) return false;
  if (!state.chunks[packet.i]) {
    state.chunks[packet.i] = packet.data;
    state.received += packet.data.length;
    state.receivedCount += 1;
  }
  return true;
}

function joinChunks(state: ReceiverState): Uint8Array {
  const bytes = new Uint8Array(state.size);
  let offset = 0;
  for (const chunk of state.chunks) {
    bytes.set(chunk!, offset);
    offset += chunk!.length;
  }
  return bytes;
}

async function finishTransfer(
  state: ReceiverState,
  link: HTMLAnchorElement,
  setStatus: (symbol: string, message: string, meta?: string) => void,
  isCurrent: () => boolean,
): Promise<boolean> {
  if (state.completed) return true;
  if (state.finishing) return false;
  if (state.receivedCount !== state.chunkCount || state.received !== state.size) {
    setStatus("⚠️", "まだ全部そろっていません。", `不足: ${state.chunkCount - state.receivedCount} 個`);
    return false;
  }
  state.finishing = true;
  setStatus("🔄", "解凍中...", "");
  try {
    const decompressed = await decompressBytes(joinChunks(state));
    if (!isCurrent()) return false;
    if (decompressed.length !== state.originalSize) throw new Error("ファイルサイズが一致しません。");
    const blob = new Blob([new Uint8Array(decompressed)], { type: state.type || "application/octet-stream" });
    if (link.href.startsWith("blob:")) URL.revokeObjectURL(link.href);
    link.href = URL.createObjectURL(blob);
    link.download = state.name || "qrdrop.bin";
    link.hidden = false;
    link.textContent = `${link.download} を保存`;
    state.completed = true;
    link.click();
    setStatus("✅", "受信が完了しました。",
      `圧縮サイズ: ${state.size} byte (元: ${state.originalSize} byte) / チャンク数: ${state.chunkCount}`);
    return true;
  } catch (error) {
    if (isCurrent()) setStatus("⚠️", "解凍エラーが発生しました。", "");
    console.error(error);
    return false;
  } finally {
    state.finishing = false;
  }
}

async function populateCameraSelect(
  select: HTMLSelectElement,
  wrap: HTMLElement,
  camera: Awaited<ReturnType<typeof selfieCamera>>,
): Promise<void> {
  try {
    const devices = await camera.listDevices();
    if (f2fCamera !== camera) return;
    select.replaceChildren(...devices.map((d) => new Option(d.label, d.deviceId)));
    wrap.hidden = devices.length <= 1;
    select.onchange = () => {
      camera.setDevice(select.value).catch((err: unknown) => {
        console.error("カメラ切替エラー:", err);
      });
    };
  } catch (err) {
    console.error("カメラ一覧取得エラー:", err);
  }
}

// === Elements ===
const f2fFileInput = document.getElementById("file-f2f-send") as HTMLInputElement;
const f2fSendBtn = document.getElementById("f2f-send-btn") as HTMLButtonElement;
const f2fRecvBtn = document.getElementById("f2f-recv-btn") as HTMLButtonElement;
const f2fStopBtn = document.getElementById("f2f-stop-btn") as HTMLButtonElement;
const f2fQrBox = document.getElementById("f2f-qr-box") as HTMLDivElement;
const f2fQrLabel = document.getElementById("f2f-qr-label") as HTMLHeadingElement;
const f2fVideo = document.getElementById("f2f-video") as HTMLVideoElement;
const f2fOverlay = document.getElementById("f2f-overlay") as HTMLCanvasElement;
const f2fInfo = document.getElementById("f2f-info") as HTMLParagraphElement;
const f2fDownloadLink = document.getElementById("f2f-download") as HTMLAnchorElement;
const f2fCameraSelectWrap = document.getElementById("f2f-camera-select-wrap") as HTMLDivElement;
const f2fCameraSelect = document.getElementById("f2f-camera-select") as HTMLSelectElement;

// A session has one role, so data QR and ACK QR always use the same display.
let f2fRole: "send" | "receive" | null = null;
let f2fSession = 0;
let f2fStartingCamera = false;
let f2fSenderState: SenderState | null = null;
let f2fReceiverState: ReceiverState | null = null;
let f2fCamera: Awaited<ReturnType<typeof selfieCamera>> | null = null;
let f2fStopScan: (() => void) | null = null;
let f2fLastAck = "";

function setF2FStatus(symbol: string, message: string, meta = ""): void {
  // Count unacknowledged QR packets, including the final END packet.
  const remaining = f2fRole === "send" && f2fSenderState
    ? f2fSenderState.completed ? 0 : f2fSenderState.packets.length - f2fSenderState.index
    : f2fRole === "receive" && f2fReceiverState
      ? f2fReceiverState.completed ? 0 : f2fReceiverState.chunkCount - f2fReceiverState.receivedCount + 1
      : null;
  f2fInfo.textContent = [
    `${symbol} ${message}`,
    remaining === null ? "" : `残りQR: ${remaining}枚`,
    meta,
  ].filter(Boolean).join(" / ");
}

function updateF2FControls(): void {
  const busy = f2fRole !== null || f2fStartingCamera;
  f2fFileInput.disabled = busy;
  f2fSendBtn.disabled = busy;
  f2fRecvBtn.disabled = busy;
  f2fStopBtn.disabled = f2fRole === null;
  f2fQrLabel.textContent = f2fRole === "send" ? "送信QR"
    : f2fRole === "receive" ? "受信確認（ACK）" : "QRコード";
}

function clearF2FDownloadLink(): void {
  if (f2fDownloadLink.href.startsWith("blob:")) URL.revokeObjectURL(f2fDownloadLink.href);
  f2fDownloadLink.hidden = true;
  f2fDownloadLink.removeAttribute("href");
  f2fDownloadLink.removeAttribute("download");
  f2fDownloadLink.textContent = "受信ファイルを保存";
}

function stopF2FSession(): void {
  f2fSession += 1; // Invalidate pending camera, compression and reconstruction work.
  f2fStopScan?.();
  f2fStopScan = null;
  f2fCamera?.stop();
  f2fCamera = null;
  f2fVideo.srcObject = null;
  f2fOverlay.getContext("2d")?.clearRect(0, 0, f2fOverlay.width, f2fOverlay.height);
  f2fCameraSelectWrap.hidden = true;
  f2fRole = null;
  f2fSenderState = null;
  f2fReceiverState = null;
  f2fLastAck = "";
  f2fQrBox.innerHTML = "";
  clearF2FDownloadLink();
  setF2FStatus("📷", "送信または受信を開始してください。");
  updateF2FControls();
}

function updateF2FSenderView(): void {
  const state = f2fSenderState;
  if (!state) return;
  if (state.completed) {
    f2fQrBox.innerHTML = "";
    setF2FStatus("✅", "送信が完了しました（終了ACK受信）。");
    return;
  }
  const packet = state.packets[state.index];
  // Keep this QR visible until the peer acknowledges it.
  renderQR(packet, f2fQrBox);
  if (packet.t === "start") {
    setF2FStatus("📤", `開始QR (${state.file.name}) - ACK待機中...`);
  } else if (packet.t === "data") {
    setF2FStatus("📤", "送信中 - ACK待機中...");
  } else {
    setF2FStatus("📤", "終了QR - 終了ACK待機中...");
  }
}

function showF2FAck(packet: Packet): void {
  const key = `${packet.id}:${packet.seq}`;
  if (key === f2fLastAck) return;
  renderQR({ t: "ack", id: packet.id, seq: packet.seq }, f2fQrBox);
  f2fLastAck = key;
}

async function handleF2FPacket(packet: Packet): Promise<void> {
  if (f2fRole === "send") {
    const state = f2fSenderState;
    if (packet.t !== "ack" || !state || state.completed) return;
    const pending = state.packets[state.index];
    if (packet.id !== pending.id || packet.seq !== pending.seq) return;
    if (state.index === state.packets.length - 1) state.completed = true;
    else state.index += 1;
    updateF2FSenderView();
    return;
  }
  if (f2fRole !== "receive" || packet.t === "ack") return;
  if (packet.t === "start") {
    if (f2fReceiverState?.id !== packet.id) {
      f2fReceiverState = createReceiver(packet);
      clearF2FDownloadLink();
      setF2FStatus("🟢", "開始QRを受信しました。ACKを表示しています。",
        `圧縮サイズ: ${packet.size} byte`);
    }
    // A retransmitted START must not discard received chunks.
    if (f2fReceiverState.receivedCount === 0) showF2FAck(packet);
    return;
  }
  const state = f2fReceiverState;
  if (!state || packet.id !== state.id) return;
  if (packet.t === "data") {
    if (packet.i > state.receivedCount || !acceptChunk(state, packet)) return;
    if (!state.completed && !state.finishing) {
      setF2FStatus("🟢", "受信しました。ACKを表示しています。");
    }
    // Old frames must not replace the ACK for the newest accepted chunk.
    if (!state.completed && packet.seq === state.receivedCount) showF2FAck(packet);
    return;
  }
  if (packet.seq === state.chunkCount + 1
    && await finishTransfer(state, f2fDownloadLink, setF2FStatus, () => f2fReceiverState === state)
    && f2fReceiverState === state) {
    showF2FAck(packet); // Keep the final ACK visible for END retransmissions.
  }
}

async function startF2FCamera(session: number): Promise<void> {
  f2fStartingCamera = true;
  updateF2FControls();
  try {
    const qr = new QRCanvas({ overlay: f2fOverlay }, {
      cropToSquare: false, overlayTimeout: 500, textDecoder: binaryText,
    });
    const activeCamera = await selfieCamera(f2fVideo);
    if (session !== f2fSession) {
      activeCamera.stop();
      f2fVideo.srcObject = null;
      return;
    }
    f2fCamera = activeCamera;
    void populateCameraSelect(f2fCameraSelect, f2fCameraSelectWrap, activeCamera);
    let reading = false;
    f2fStopScan = frameLoop(async () => {
      if (reading) return;
      reading = true;
      try {
        const result = await activeCamera.readFrame(qr);
        if (f2fCamera !== activeCamera) return;
        for (const text of Array.isArray(result) ? result : [result]) {
          if (f2fCamera !== activeCamera) break;
          if (typeof text !== "string") continue;
          const packet = parsePacket(text);
          if (packet) await handleF2FPacket(packet);
        }
      } catch (error) {
        console.error("QR読み取りエラー:", error);
      } finally {
        reading = false;
      }
    }, f2fVideo);
  } catch (error) {
    throw new Error("カメラを開始できませんでした。権限を確認してください。", { cause: error });
  } finally {
    f2fStartingCamera = false;
    updateF2FControls();
  }
}

async function startF2FSession(role: "send" | "receive", file?: File): Promise<void> {
  if (f2fRole !== null || f2fStartingCamera) return;
  stopF2FSession();
  const session = f2fSession;
  f2fRole = role;
  setF2FStatus("📷", "カメラを起動中...");
  updateF2FControls();
  try {
    await startF2FCamera(session);
    if (session !== f2fSession) return;
    if (role === "send" && file) {
      setF2FStatus("🔄", "圧縮中...");
      const state = await prepareSender({
        name: file.name, type: file.type,
        bytes: new Uint8Array(await file.arrayBuffer()),
      });
      if (session !== f2fSession) return;
      f2fSenderState = state;
      updateF2FSenderView();
    } else {
      setF2FStatus("📷", "読み取り中です。相手の送信QRを映してください。");
    }
  } catch (error) {
    if (session !== f2fSession) return;
    stopF2FSession();
    setF2FStatus("⚠️", error instanceof Error ? error.message : "転送を開始できませんでした。");
    console.error(error);
  }
}

f2fSendBtn.addEventListener("click", async () => {
  const file = f2fFileInput.files?.item(0);
  if (!file) {
    setF2FStatus("⚠️", "送信するファイルを選んでください。");
    return;
  }
  await startF2FSession("send", file);
});

f2fRecvBtn.addEventListener("click", async () => {
  await startF2FSession("receive");
});

f2fStopBtn.addEventListener("click", stopF2FSession);
window.addEventListener("pagehide", stopF2FSession);
updateF2FControls();
clearF2FDownloadLink();
</script>

<style is:global>
  .nue [hidden] {
    display: none !important;
  }
  .c,
  .facetoface-panel {
    text-align: center;
  }
  .transfer-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    align-items: center;
  }
  .transfer-controls input {
    max-width: 100%;
  }
  .facetoface-layout {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
    align-items: start;
    margin-top: 1rem;
  }
  .facetoface-side {
    min-width: 0;
  }
  .facetoface-side h3 {
    margin: 0 0 1rem;
    font-size: 1.1rem;
  }
  #f2f-qr-box {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    max-width: 640px;
    aspect-ratio: 1;
    margin: 0 auto;
    background: white;
    border-radius: 4px;
    overflow: hidden;
  }
  #f2f-qr-box:empty::before {
    content: "転送開始後にQRを表示します";
    color: #555;
  }
  #f2f-qr-box svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .camera-wrap {
    position: relative;
    width: 100%;
    max-width: 420px;
    min-height: 180px;
    margin: 0 auto;
    background: #111;
  }
  #f2f-video,
  #f2f-overlay {
    width: 100%;
    display: block;
  }
  #f2f-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
