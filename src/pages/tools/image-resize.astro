---
import Layout from "../../layouts/layout.astro";
import A from "../../components/A.astro";
---

<Layout title="画像リサイズ・切り抜き | taisan11のサイト">
  <div class="nue">
    <A href="/tools">← 戻る</A>
    <h2>画像圧縮</h2>
    <div class="toolbar">
      <label for="image" class="action-control">画像を選択</label><input type="file" id="image" accept="image/*" hidden/>
      <select id="format" class="action-control" aria-label="フォーマット">
        <option value="webp">WebP</option>
        <option value="avif">AVIF</option>
        <option value="jpeg">JPEG</option>
        <option value="png">PNG</option>
      </select>
      <button id="download" class="action-control" disabled>ダウンロード</button>
      <span id="original-size" aria-live="polite"></span>
      <span id="file-size" aria-live="polite"></span>
    </div>
    <div class="controls">
      <label>
        <span>クオリティ <output id="quality-value">100</output></span>
        <input type="range" id="quality" min="0" max="100" step="1" value="100"/>
      </label>
      <label>
        <span>スピード <output id="speed-value">10</output></span>
        <input type="range" id="speed" min="0" max="10" step="1" value="10"/>
      </label>
    </div>
    <p id="status" role="status"></p>
    <div class="previews">
        <img id="original" src="" alt="original" style="display: none;"/>
        <img id="optimized" src="" alt="optimized" style="display: none;"/>
    </div>
  </div>
</Layout>

<script>
import {optimizeImage} from "wasm-image-optimization"
const img = document.getElementById("image") as HTMLInputElement;
const original = document.getElementById("original") as HTMLImageElement;
const optimized = document.getElementById("optimized") as HTMLImageElement;
const button = document.getElementById("download") as HTMLButtonElement;
const format = document.getElementById("format") as HTMLSelectElement;
const quality = document.getElementById("quality") as HTMLInputElement;
const speed = document.getElementById("speed") as HTMLInputElement;
const qualityValue = document.getElementById("quality-value") as HTMLOutputElement;
const speedValue = document.getElementById("speed-value") as HTMLOutputElement;
const status = document.getElementById("status") as HTMLParagraphElement;
const originalSize = document.getElementById("original-size") as HTMLSpanElement;
const fileSize = document.getElementById("file-size") as HTMLSpanElement;

let selectedFile: File | null = null;
let optimizedBlob: Blob | null = null;
let optimizedUrl = "";
let originalUrl = "";
let requestId = 0;
let optimizeTimer: ReturnType<typeof setTimeout> | undefined;

function formatFileSize(bytes: number) {
  if (bytes < 1024) return `${bytes} B`;
  if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
  return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
}

const mimeTypes: Record<string, string> = {
  avif: "image/avif",
  jpeg: "image/jpeg",
  png: "image/png",
  webp: "image/webp",
};

async function optimize() {
  if (!selectedFile) return;

  const currentRequest = ++requestId;
  status.textContent = "変換中...";
  button.disabled = true;
  try {
    const result = await optimizeImage({
      image: await selectedFile.arrayBuffer(),
      quality: Number(quality.value),
      speed: Number(speed.value),
      format: format.value,
    });
    if (currentRequest !== requestId) return;

    optimizedBlob = new Blob([new Uint8Array(result.data)], { type: mimeTypes[format.value] });
    if (optimizedUrl) URL.revokeObjectURL(optimizedUrl);
    optimizedUrl = URL.createObjectURL(optimizedBlob);
    optimized.src = optimizedUrl;
    optimized.style.display = "block";
    fileSize.textContent = `optimized: ${formatFileSize(optimizedBlob.size)}`;
    status.textContent = "変換完了";
  } catch {
    if (currentRequest === requestId) status.textContent = "画像を変換できませんでした";
  } finally {
    if (currentRequest === requestId) button.disabled = false;
  }
}

function scheduleOptimize() {
  if (optimizeTimer) clearTimeout(optimizeTimer);
  optimizeTimer = setTimeout(() => void optimize(), 250);
}

img.onchange = async () => {
  if (!img.files || img.files.length === 0) return;
  selectedFile = img.files[0];
  originalSize.textContent = `origin: ${formatFileSize(selectedFile.size)}`;
  if (originalUrl) URL.revokeObjectURL(originalUrl);
  originalUrl = URL.createObjectURL(selectedFile);
  original.src = originalUrl;
  original.style.display = "block";
  await optimize();
};

quality.oninput = () => {
  qualityValue.value = quality.value;
  scheduleOptimize();
};

speed.oninput = () => {
  speedValue.value = speed.value;
  scheduleOptimize();
};

format.onchange = () => void optimize();

button.onclick = () => {
  if (!optimizedUrl || !optimizedBlob) return;
  const a = document.createElement("a");
  a.href = optimizedUrl;
  a.download = `optimized.${format.value}`;
  a.click();
};
</script>

<style is:global>
  .nue { max-width: 720px; margin: 0 auto; }
  h2 { text-align: center; }
  .toolbar { display: flex; align-items: center; gap: 0.5rem; margin: 1rem 0; }
  .action-control { box-sizing: border-box; padding: 0.5rem; border: 0; border-radius: 4px; background-color: #007BFF; color: white; font: inherit; cursor: pointer; }
  select.action-control { appearance: auto; }
  .action-control:disabled { cursor: not-allowed; opacity: 0.5; }
  #original-size, #file-size { white-space: nowrap; }
  .controls { display: flex; gap: 1.5rem; margin: 1rem 0; }
  .controls label { display: grid; flex: 1; gap: 0.25rem; }
  .controls output { float: right; }
  .controls input[type="range"] { width: 100%; }
  #status { min-height: 1.5rem; }
  .previews { display: flex; justify-content: center; gap: 1rem; margin-top: 1rem; }
  .previews img { max-width: 45vw; max-height: 60vh; object-fit: contain; border: 1px solid #ccc; }
  @media (max-width: 480px) {
    .toolbar { flex-wrap: wrap; }
    .controls { gap: 0.75rem; }
  }
</style>
